# Copy to .env and fill in. NEVER commit .env.
# Keys: generate once with   python seed/inject.py --gen-keys
#       and never regenerate them after data is injected (old data becomes unreadable).

HMAC_KEY=
MASTER_KEY=
MASTER_KEY_VERSION=1

# Database. These values are for tools running ON THE LAPTOP (php test scripts, psql).
# Inside Docker, compose overrides host/port with db:5432.
DATABASE_URL=localhost
DATABASE_PORT=5433
DATABASE_NAME=jobboard
DATABASE_USER=postgres
DATABASE_MDP=change-me
