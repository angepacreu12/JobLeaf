# ============================================================
#  jobviewphingy - .gitignore
# ============================================================

# ---------- Secrets (NEVER commit) ----------
# Real keys + DB password. Only the template is versioned.


# ---------- PHP / Composer ----------
# Rebuilt by "composer install" (Docker does it automatically)
/vendor/

# PHPUnit / PHPStan caches
.phpunit.cache/
.phpunit.result.cache
.phpstan/
coverage/

# ---------- Python ----------
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.pytest_cache/
vendor/

vendor/
seed/inject_report.json
__pycache__/
.venv/
venv/
composer.lock

# ---------- Seed outputs ----------
# Regenerated on every injection, contains plaintext test passwords + raw tokens.
# (seed_data.json IS committed: fixed --seed 42, fake accounts only)
inject_report.json

# ---------- Docker ----------
# Local-only overrides you don't want to share
docker-compose.local.yml

# ---------- Editors / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- LibreOffice lock files (docs/*.ods open) ----------
.~lock.*#

# ---------- Logs / archives / temp ----------
*.log
*.zip
*.tmp
cookies.txt

*.locl
composer.*
.claude
docker/seed/inject_report.json
